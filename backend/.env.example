# Ollama (open-source LLM runtime)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# CPU'da hız için: qwen2.5:3b-instruct veya llama3.2:3b (ollama pull …)
OLLAMA_NUM_PREDICT=512

# Knowledge directory (relative to repo root or absolute path)
KNOWLEDGE_DIR=../knowledge

# CORS — Next.js dev / production origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Phase 2 — voice (GPU server defaults)
VOICE_ENABLED=true
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# CPU laptop: WHISPER_MODEL=base WHISPER_DEVICE=cpu WHISPER_COMPUTE_TYPE=int8

# Piper — bash scripts/download-piper-tr.sh from repo root
PIPER_MODEL_PATH=../models/piper/tr_TR-dfki-medium.onnx
PIPER_USE_CUDA=true
# Optional CLI fallback instead of piper-tts Python package:
# PIPER_BINARY=piper

# Phase 3 — PostgreSQL + pgvector
# DATABASE_URL=postgresql://user:pass@localhost:5432/twin
